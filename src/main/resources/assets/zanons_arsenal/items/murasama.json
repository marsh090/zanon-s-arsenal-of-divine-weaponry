{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed", "on_shelf"],
        "model": {
          "type": "minecraft:condition",
          "property": "zanons_arsenal:sheathed",
          "on_true": {
            "type": "minecraft:model",
            "model": "zanons_arsenal:item/murasama_sheathed"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "zanons_arsenal:item/murasama"
          }
        }
      },
      {
        "when": "head",
        "model": {
          "type": "minecraft:condition",
          "property": "zanons_arsenal:sheathed",
          "on_true": {
            "type": "minecraft:model",
            "model": "zanons_arsenal:weapon/murasama_sheathed"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "zanons_arsenal:weapon/murasama_scabbard"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "zanons_arsenal:sheathed",
      "on_true": {
        "type": "minecraft:empty"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "zanons_arsenal:weapon/murasama"
      }
    }
  }
}
